# Oracle site url
ORACLE_URL=

# Oracle Fusion / Microsoft SSO credentials
# The RSA push notification will go to the real user's phone for approval
ORACLE_EMAIL=
ORACLE_PASSWORD=

# OpenText Content Server credentials (for F&F Exit Document Downloader)
CONTENT_SERVER_URL=

# Automation settings
# Set to true for background runs, or false to watch the browser in action
HEADLESS=true
# Set to true to start the browser maximized in visible mode (when HEADLESS=false)
START_MAXIMIZED=true
# Optional: Set browser channel ("chrome" to use installed Google Chrome, or leave blank for bundled Chromium)
# BROWSER_CHANNEL=chrome
# Optional: Set custom window position, e.g. "0,0" (leave blank for standard visible display)
# WINDOW_POSITION=

# SharePoint credentials
SHAREPOINT_TENANT_ID=
SHAREPOINT_SITE_URL=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TARGET_FOLDER=